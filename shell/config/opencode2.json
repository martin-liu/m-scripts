{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "plugin": [
    "oh-my-opencode-slim@2.2.17"
  ],
  "enabled_providers": [
    "openrouter",
    "azure",
    "azure-kimi-k2",
    "azure-westus3",
    "azure-openai",
    "ollama",
    "amazon-bedrock"
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/martin/code/**": "allow",
      "~/.config/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "tokens": 50000
    },
    "buffer": 850000
  },
  "small_model": "azure-openai/gpt-5.6-luna",
  "provider": {
    "ollama": {
      "models": {
        "qwen3.6:35b-a3b-q8_0": {
          "_launch": true,
          "name": "qwen3.6:35b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "azure": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure WestUS",
      "options": {
        "baseURL": "{env:AZURE_API_BASE_NANDDEVWESTUS}/openai/deployments/Kimi-K3",
        "headers": {
          "api-key": "{env:AZURE_API_KEY_NANDDEVWESTUS}"
        },
        "queryParams": {
          "api-version": "{env:AZURE_API_VERSION}"
        }
      },
      "models": {
        "Kimi-K3": {
          "name": "Kimi-K3",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 3.3,
            "output": 16.5,
            "cache_read": 0.33
          },
          "limit": {
            "context": 262144,
            "input": 262144,
            "output": 49152
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        }
      }
    },
    "azure-kimi-k2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure WestUS",
      "options": {
        "baseURL": "{env:AZURE_API_BASE_NANDDEVWESTUS3}/openai/deployments/Kimi-K2.7-Code",
        "headers": {
          "api-key": "{env:AZURE_API_KEY_NANDDEVWESTUS3}"
        },
        "queryParams": {
          "api-version": "{env:AZURE_API_VERSION}"
        }
      },
      "models": {
        "Kimi-K2.7-Code": {
          "name": "Kimi-K2.7-Code",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.95,
            "cache_read": 0.19,
            "output": 4
          },
          "limit": {
            "context": 262144,
            "input": 262144,
            "output": 49152
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        }
      }
    },
    "azure-westus3": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure CentralUS",
      "options": {
        "baseURL": "{env:AZURE_API_BASE_NANDDEVWESTUS3}/openai/deployments/DeepSeek-V4-Flash-0731",
        "headers": {
          "api-key": "{env:AZURE_API_KEY_NANDDEVWESTUS3}"
        },
        "queryParams": {
          "api-version": "{env:AZURE_API_VERSION}"
        }
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "cost": {
            "input": 0.15,
            "output": 0.31,
            "cache_read": 0.03
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        }
      }
    },
    "amazon-bedrock": {
      "options": {
        "region": "{env:AWS_REGION_BEDROCK}"
      },
      "models": {
        "us.anthropic.claude-opus-4-8-20251101-v1:0": {
          "name": "claude-opus-4.8 (cross-region)",
          "cost": {
            "input": 5,
            "output": 25,
            "cache_read": 0.5,
            "cache_write": 6.25
          },
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "anthropic.claude-opus-4-8": {
          "name": "claude-opus-4.8",
          "cost": {
            "input": 5,
