            "output": 30,
            "cache_read": 0.5,
            "cache_write": 6.25,
            "context_over_200k": {
              "input": 10,
              "output": 45,
              "cache_read": 1,
              "cache_write": 12.5
            }
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "reasoning": true,
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
