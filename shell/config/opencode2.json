  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "model": "azure-openai/gpt-5.6-terra",
  "default_agent": "orchestrator",
  "share": "manual",
  "logLevel": "DEBUG"
}
