{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "plugin": [
    "oh-my-opencode-slim@latest"
  ],
  "enabled_providers": [
    "openrouter",
    "ollama",
    "litellm"
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/martin/code/**": "allow",
      "~/.config/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 50000,
    "reserved": 850000
  },
  "small_model": "litellm/gpt-5.6-luna",
  "provider": {
    "ollama": {
      "models": {
        "qwen3.6:35b-a3b-q8_0": {
          "_launch": true,
          "name": "qwen3.6:35b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LITELLM_PROXY_API_BASE}",
        "apiKey": "{env:LITELLM_PROXY_API_KEY}"
      },
      "models": {
        "DeepSeek-V4-Flash": {},
        "DeepSeek-V4-Pro": {},
        "gpt-5.6-luna": {
          "reasoning": true,
          "variants": {
            "none": {"reasoningEffort": "none"},
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "high": {"reasoningEffort": "high"},
            "xhigh": {"reasoningEffort": "xhigh"},
            "max": {"reasoningEffort": "max"}
          }
        },
        "gpt-5.6-sol": {
          "reasoning": true,
          "variants": {
            "none": {"reasoningEffort": "none"},
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "high": {"reasoningEffort": "high"},
            "xhigh": {"reasoningEffort": "xhigh"},
            "max": {"reasoningEffort": "max"}
          }
        },
        "gpt-5.6-terra": {
          "reasoning": true,
          "variants": {
            "none": {"reasoningEffort": "none"},
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "high": {"reasoningEffort": "high"},
            "xhigh": {"reasoningEffort": "xhigh"},
            "max": {"reasoningEffort": "max"}
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "model": "litellm/gpt-5.6-terra",
  "default_agent": "orchestrator",
  "share": "manual",
  "logLevel": "DEBUG"
}
