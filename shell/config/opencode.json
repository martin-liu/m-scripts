{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "enabled_providers": [
    "openrouter",
    "ollama",
    "litellm"
  ],
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/private/**": "allow",
      "~/martin/code/**": "allow",
      "~/.config/**": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 50000
    },
    "buffer": 20000
  },
  "plugins": [
    "./plugins/zellij-attention"
  ],
  "small_model": "litellm/gpt-5.6-luna",
  "provider": {
    "ollama": {
      "models": {
        "qwen3.6:35b-a3b-q8_0": {
          "_launch": true,
          "name": "qwen3.6:35b"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LITELLM_PROXY_API_BASE}",
        "apiKey": "{env:LITELLM_PROXY_API_KEY}"
      },
      "models": {
        "DeepSeek-V4.1-Flash": {
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache_read": 0.006,
            "cache_write": 0.006
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "DeepSeek-V4-Pro": {},
        "gpt-5.6-luna": {
          "limit": {
            "context": 1000000,
            "input": 215000,
            "output": 32000
          },
          "cost": {
            "input": 0.20,
            "output": 1.20,
            "cache_read": 0.02,
            "cache_write": 0.25,
            "context_over_200k": {
              "input": 0.40,
              "output": 1.80,
              "cache_read": 0.04,
              "cache_write": 0.50
            }
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-sol": {
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.40,
            "cache_write": 5,
            "context_over_200k": {
              "input": 8,
              "output": 30,
              "cache_read": 0.80,
              "cache_write": 10
            }
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-terra": {
          "cost": {
            "input": 2,
            "output": 12,
            "cache_read": 0.20,
            "cache_write": 2.50,
            "context_over_200k": {
              "input": 4,
              "output": 18,
              "cache_read": 0.40,
              "cache_write": 5
            }
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "agents": {
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "default_agent": "orchestrator",
  "share": "manual"
}
